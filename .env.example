# Static bearer token MCP clients must send as `Authorization: Bearer <token>`.
# Guards /mcp only. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=generate-a-random-token-here

# HTTP Basic Auth for the dashboard at / and its /api routes. This is the only
# thing between real health data and a public hostname, so use a generated
# password, not one you type from memory:  openssl rand -base64 18
DASHBOARD_USER=you
DASHBOARD_PASSWORD=generate-a-random-password-here

# Where the SQLite database lives. Mount a volume on its directory or the whole
# workout history dies with the container. Optional.
WORKOUT_DB=/data/workouts.db

# IANA timezone "today" is resolved in. The container runs UTC, so without this
# an evening workout lands on the following day. Optional, defaults to
# America/Chicago.
WORKOUT_TIMEZONE=America/Chicago
